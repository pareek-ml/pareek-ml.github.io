---
import type { CollectionEntry } from 'astro:content';
import Arrow from './Arrow.astro';

const { entry, level = 'h3' } = Astro.props as { entry: CollectionEntry<'work'>; level?: 'h2' | 'h3' };
const { title, sector, summary, metrics } = entry.data;
const Heading = level;
---
<article class="work-card reveal">
  <p class="work-sector">{sector}</p>
  <Heading class="work-title"><a class="link" href={`/work/${entry.id}/`}>{title}</a></Heading>
  <p class="work-summary">{summary}</p>
  {metrics.length > 0 && (
    <dl class="work-metrics">
      {metrics.slice(0, 2).map(({ value, label }) => (
        <div><dt>{label}</dt><dd>{value}</dd></div>
      ))}
    </dl>
  )}
  <div class="work-card-end"><Arrow /></div>
</article>
