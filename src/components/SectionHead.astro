---
/**
 * A homepage section head: a short uppercase label over the action title, a full sentence that makes the section's point.
 * Read top to bottom, the titles tell the page's argument on their own. The slot holds an optional link on the right.
 */
interface Props {
  kicker: string;
  title: string;
  reveal?: boolean;
}
const { kicker, title, reveal = true } = Astro.props;
---
<div class:list={['section-head', { reveal }]}>
  <div>
    <p class="section-kicker">{kicker}</p>
    <h2 class="section-title">{title}</h2>
  </div>
  <slot />
</div>
