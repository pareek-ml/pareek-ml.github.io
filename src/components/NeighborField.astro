<figure class="field">
  <div class="field-canvas"><canvas data-neighbor-field aria-hidden="true"></canvas></div>
  <figcaption>Nearest neighbors, embedding space</figcaption>
</figure>

<script>
  // A query point drifts through clustered points, linked to its nearest neighbors.
  const canvas = document.querySelector<HTMLCanvasElement>('[data-neighbor-field]');
  const ctx = canvas?.getContext('2d');

  if (canvas && ctx) {
    const NEIGHBORS = 6;
    const MIN_FRAME_MS = 1000 / 30;
    const motion = matchMedia('(prefers-reduced-motion: reduce)');
    const scheme = matchMedia('(prefers-color-scheme: dark)');

    // Seeded so the composition is the same on every visit.
    let seed = 20240917;
    const rand = () => {
      seed = (seed * 1664525 + 1013904223) >>> 0;
      return seed / 2 ** 32;
    };
    const gaussian = () => Math.sqrt(-2 * Math.log(rand() || 1e-6)) * Math.cos(2 * Math.PI * rand());

    // Keeps points clear of the canvas edge, where they would be clipped.
    const inset = (value: number) => Math.min(0.97, Math.max(0.03, value));

    const clusters = [
      [0.26, 0.24, 0.085, 24], [0.68, 0.17, 0.07, 18], [0.8, 0.5, 0.075, 22],
      [0.44, 0.55, 0.09, 30], [0.17, 0.72, 0.075, 20], [0.66, 0.84, 0.08, 22],
    ];
    const points = clusters.flatMap(([cx, cy, spread, count]) =>
      Array.from({ length: count }, () => ({
        baseX: inset(cx + gaussian() * spread),
        baseY: inset(cy + gaussian() * spread),
        phase: rand() * Math.PI * 2,
        rate: 0.5 + rand() * 0.5,
        r: rand() < 0.16 ? 2.6 : 1.7,
        x: 0,
        y: 0,
      })),
    );

    let width = 0;
    let height = 0;
    let ink = '#111';
    let raf = 0;
    let visible = false;
    let last = 0;
    let elapsed = 40; // Opens on a settled composition, including for reduced motion.

    function draw() {
      const t = elapsed;
      const size = Math.min(width, height);
      for (const p of points) {
        p.x = (p.baseX + Math.sin(t * 0.09 * p.rate + p.phase) * 0.012) * width;
        p.y = (p.baseY + Math.cos(t * 0.07 * p.rate + p.phase) * 0.012) * height;
      }
      // The query point follows a slow closed curve that passes through the clusters.
      const qx = (0.5 + 0.34 * Math.sin(t * 0.031) + 0.08 * Math.sin(t * 0.083)) * width;
      const qy = (0.5 + 0.34 * Math.cos(t * 0.023 + 1) + 0.06 * Math.cos(t * 0.071)) * height;
      const nearest = points
        .map((p) => ({ p, d: Math.hypot(p.x - qx, p.y - qy) }))
        .sort((a, b) => a.d - b.d)
        .slice(0, NEIGHBORS);
      const linked = new Set(nearest.map((n) => n.p));

      ctx!.clearRect(0, 0, width, height);
      ctx!.fillStyle = ctx!.strokeStyle = ink;

      ctx!.globalAlpha = 0.7;
      ctx!.lineWidth = 0.9;
      ctx!.beginPath();
      for (const { p } of nearest) {
        ctx!.moveTo(qx, qy);
        ctx!.lineTo(p.x, p.y);
      }
      ctx!.stroke();

      for (const p of points) {
        const isLinked = linked.has(p);
        ctx!.globalAlpha = isLinked ? 1 : 0.5;
        ctx!.beginPath();
        ctx!.arc(p.x, p.y, isLinked ? p.r + 0.8 : p.r, 0, Math.PI * 2);
        ctx!.fill();
      }

      ctx!.globalAlpha = 1;
      ctx!.lineWidth = 1.25;
      ctx!.beginPath();
      ctx!.arc(qx, qy, Math.max(5, size * 0.016), 0, Math.PI * 2);
      ctx!.stroke();
    }

    function frame(now: number) {
      raf = requestAnimationFrame(frame);
      if (now - last < MIN_FRAME_MS) return;
      elapsed += Math.min(now - last, 100) / 1000;
      last = now;
      draw();
    }

    function sync() {
      cancelAnimationFrame(raf);
      raf = 0;
      if (visible && !document.hidden && !motion.matches) {
        last = performance.now();
        raf = requestAnimationFrame(frame);
      }
    }

    function resize() {
      const box = canvas!.getBoundingClientRect();
      const dpr = Math.min(devicePixelRatio || 1, 2);
      width = box.width;
      height = box.height;
      canvas!.width = Math.round(width * dpr);
      canvas!.height = Math.round(height * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      draw();
    }

    function refreshInk() {
      ink = getComputedStyle(document.documentElement).getPropertyValue('--ink').trim() || ink;
      draw();
    }

    refreshInk();
    new ResizeObserver(resize).observe(canvas);
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      sync();
    }).observe(canvas);
    document.addEventListener('visibilitychange', sync);
    motion.addEventListener('change', sync);
    scheme.addEventListener('change', refreshInk);
  }
</script>
