---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const { kind, figure } = Astro.props as {
  kind: string;
  figure?: { image?: ImageMetadata; alt?: string; caption: string };
};
---
{figure?.image && (
  <figure class="figure">
    <p class="figure-kind">{kind}</p>
    <div class="figure-frame">
      <Image src={figure.image} alt={figure.alt ?? ''} widths={[480, 800, 1200]} sizes="(max-width: 860px) 100vw, 740px" />
    </div>
    <figcaption>{figure.caption}</figcaption>
  </figure>
)}
