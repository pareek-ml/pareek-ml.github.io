---
import Base from '../../layouts/Base.astro';
import PostRow from '../../components/PostRow.astro';
import { getPosts, getSite } from '../../lib/content';

const site = await getSite();
const posts = await getPosts();
const medium = site.socials.find((social) => social.label === 'Medium');
---
<Base title="Writing" description="Notes on AI, machine learning, programming, and technology.">
  <div class="wrap page-head">
    <h1 class="page-title">Writing</h1>
    <p class="page-lede">Notes on AI, machine learning, programming, and technology.</p>
  </div>
  <div class="wrap page-body">
    <div class="posts">
      {posts.map((post) => <PostRow post={post} level="h2" />)}
    </div>
    {medium && (
      <p class="page-lede">More posts are on the way. Follow me on <a class="link link--on" href={medium.url} rel="me noopener">Medium</a> for the latest updates.</p>
    )}
  </div>
</Base>
