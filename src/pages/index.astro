---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import NeighborField from '../components/NeighborField.astro';
import PostRow from '../components/PostRow.astro';
import SectionHead from '../components/SectionHead.astro';
import Value from '../components/Value.astro';
import WorkCard from '../components/WorkCard.astro';
import { getOrdered, getPosts, getSite, getWork } from '../lib/content';

const site = await getSite();
const work = await getWork();
const featured = work.filter((entry) => entry.data.featured);
// Each proof figure links to the case study behind it. A missing case study fails the build rather than shipping a broken link.
const proof = site.proof_metrics.map((metric) => {
  if (!metric.work) return { ...metric, entry: undefined };
  const entry = work.find((item) => item.id === metric.work);
  if (!entry) throw new Error(`site.yaml proof metric "${metric.value}" links to a case study that doesn't exist or is a draft: ${metric.work}`);
  return { ...metric, entry };
});
const posts = (await getPosts()).slice(0, 3);
const steps = await getOrdered('approach');
const jobs = await getOrdered('experience');
const capabilities = await getOrdered('capabilities');
const linkedIn = site.socials.find((social) => social.label === 'LinkedIn');
const { sections } = site;
// One old post reads as an abandoned blog, so the section waits until there are at least two.
const showWriting = posts.length >= 2;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: 'https://ypareek.ch/',
  image: 'https://ypareek.ch/og.png',
  jobTitle: site.role,
  description: site.description,
  worksFor: { '@type': 'Organization', name: 'World Trade Organization', url: 'https://www.wto.org/' },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Università della Svizzera Italiana' },
    { '@type': 'CollegeOrUniversity', name: 'Rajasthan Technical University' },
  ],
  email: `mailto:${site.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Geneva', addressCountry: 'CH' },
  sameAs: site.socials.map((social) => social.url),
};
---
<Base ogType="profile" jsonLd={jsonLd}>
  <section class="hero">
    <div class="wrap grid">
      <div class="hero-copy">
        <p class="eyebrow">{site.eyebrow}</p>
        <h1>{site.headline}</h1>
        <p class="hero-sub">{site.subheadline}</p>
        <div class="cta">
          <a class="btn btn--solid" href="/work/">View work</a>
          <a class="btn btn--line" href={site.cv} download>Download CV</a>
        </div>
      </div>
      <NeighborField />
    </div>
  </section>

  <section class="proof" aria-label="Selected results">
    <ul class="wrap proof-list">
      {proof.map(({ value, label, entry }) => (
        <li>
          {entry ? (
            <a class="proof-item" href={`/work/${entry.id}/`}>
              <span class="proof-value"><Value value={value} /></span>
              <span class="proof-label"><span class="link">{label}</span></span>
              <span class="proof-more"><span class="visually-hidden">Case study: {entry.data.title}</span><Arrow /></span>
            </a>
          ) : (
            <div class="proof-item">
              <span class="proof-value"><Value value={value} /></span>
              <span class="proof-label">{label}</span>
            </div>
          )}
        </li>
      ))}
    </ul>
  </section>

  <section class="section" id="work">
    <div class="wrap">
      <SectionHead {...sections.work}>
        <a class="arrow-link" href="/work/"><span class="link">All work</span><Arrow /></a>
      </SectionHead>
      <div class="work-grid">
        {featured.map((entry) => <WorkCard entry={entry} />)}
      </div>
    </div>
  </section>

  <section class="section" id="approach">
    <div class="wrap">
      <SectionHead {...sections.approach} />
      <ol class="steps reveal">
        {steps.map(({ data }) => (
          <li class="step">
            <h3>{data.title}</h3>
            <p>{data.outcome}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" id="experience">
    <div class="wrap">
      <SectionHead {...sections.experience} />
      <div class="timeline reveal">
        {jobs.map(({ data }) => (
          <details class="job">
            <summary class="grid">
              <span class="job-dates">{data.dates}</span>
              <div class="job-main">
                <h3 class="job-employer">{data.employer}</h3>
                <p class="job-role">{data.role}, {data.location}</p>
                <p class="job-impact">{data.impact}</p>
              </div>
              <span class="job-toggle" aria-hidden="true"></span>
            </summary>
            <div class="grid">
              <div class="job-detail">
                <ul>{data.details.map((line) => <li>{line}</li>)}</ul>
                {data.url && <p><a class="link link--on" href={data.url} rel="noopener">Visit {data.employer}</a></p>}
              </div>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="capabilities">
    <div class="wrap">
      <SectionHead {...sections.capabilities} />
      <div class="cap-columns reveal">
        {capabilities.map(({ data }) => (
          <div>
            <h3>{data.title}</h3>
            {data.summary && <p class="cap-summary">{data.summary}</p>}
            <ul>{data.lines.map((line) => <li>{line}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  {showWriting && (
  <section class="section" id="writing">
    <div class="wrap">
      <SectionHead {...sections.writing} />
      <div class="reveal">
        <div class="posts">
          {posts.map((post) => <PostRow post={post} />)}
        </div>
      </div>
    </div>
  </section>
  )}

  <section class="section" id="contact">
    <div class="wrap reveal">
      <h2 class="contact-title">{sections.contact.title}</h2>
      <p class="contact-lede">{sections.contact.lede}</p>
      <ul class="contact-links">
        <li><a class="link link--on" href={`mailto:${site.email}`}>{site.email}</a></li>
        {linkedIn && <li><a class="link link--on" href={linkedIn.url} rel="me noopener">LinkedIn</a></li>}
      </ul>
    </div>
  </section>
</Base>
