---
import Base from '../../layouts/Base.astro';
import WorkCard from '../../components/WorkCard.astro';
import { getWork } from '../../lib/content';

const work = await getWork();
---
<Base title="Work" description="Four AI systems in production at the World Trade Organization: trade-measure monitoring, a sovereign AI platform, a customs-code recommender and a permission-aware knowledge assistant.">
  <div class="wrap page-head">
    <h1 class="page-title">Work</h1>
  </div>
  <div class="wrap page-body">
    <div class="work-grid">
      {work.map((entry) => <WorkCard entry={entry} level="h2" />)}
    </div>
  </div>
</Base>
